// ===========================================================================
//  公式LINE 未返信リマインドシステム — データベーススキーマ
//  設計意図の詳細は docs/03-database-design.md を参照
// ===========================================================================

generator client {
  provider      = "prisma-client-js"
  /**
   * ビルドは Linux(Debian) 上で行われるが、Netlify Functions の実行環境は
   * AWS Lambda(Amazon Linux) である。native だけだと実行時に
   * 「Query engine binary for current platform could not be found」で落ちるため、
   * 実行環境用のエンジンも一緒に生成しておく。
   */
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // アプリ実行時の接続。サーバーレスでは接続数を抑えるためプーラー経由にする
  url       = env("DATABASE_URL")
  // マイグレーション実行時の接続。
  // Supabase の Transaction pooler(6543) は Prisma migrate が使う
  // アドバイザリロックに対応していないため、別経路を指定できるようにしている。
  // プーラーを使わない環境では DATABASE_URL と同じ値を入れてよい。
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// メッセージの向き
enum Direction {
  INBOUND /// 顧客 → 公式LINE
  OUTBOUND /// 公式LINE → 顧客（担当者の返信）
}

/// 未返信状態機械（システムが自動判定する内部状態）
enum ReplyState {
  AWAITING /// 未返信（顧客の最新メッセージ > 担当者の最新返信）
  REPLIED /// 返信済み
}

/// 管理画面で人が管理する対応状況
enum HandlingStatus {
  UNHANDLED /// 未対応
  IN_PROGRESS /// 対応中
  DONE /// 対応済み
  NEEDS_CHECK /// 要確認
}

enum StaffRole {
  STAFF /// 担当者
  MANAGER /// 責任者
  ADMIN /// 管理者
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

/// リマインドの種別
enum ReminderKind {
  ROUTINE /// 通常の定期リマインド
  ESCALATION /// 閾値超過によるエスカレーション
  GUARD /// 連投による起点リセットを打ち消す保険通知
  WATCHDOG /// 配信遅延検知（システム異常の通知）
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED /// 確保後、送信直前の再判定で「返信済み」と判明したため中止
}

/// 通知チャネル種別
enum ChannelType {
  LINE_GROUP /// LINE Messaging API push（グループ宛）
  LINE_USER /// LINE Messaging API push（個人宛）
  WEBHOOK /// 汎用 Webhook（Slack / Discord / LINE WORKS 等）
}

/// 通知チャネルの役割
enum ChannelPurpose {
  DEFAULT_GROUP /// 社内共通の通知先。担当者未設定時の受け皿であり、同報先でもある
  ADMIN /// 管理者向け（エスカレーション最終段・watchdog）
  FALLBACK /// 主経路が連続失敗したときの代替
}

/// 「返信済み」と判定した経路
enum ResolvedVia {
  ADMIN_REPLY /// 管理画面から返信を送信した
  MANUAL /// 管理画面で「対応済み」に変更した
  INGEST_API /// 外部連携から返信を取り込んだ
  WEBHOOK /// LINE Webhook 由来の送信イベント（Module Channel 等）
  LINE_POSTBACK /// 社内LINE通知の「対応済みにする」ボタンをタップした
}

// ---------------------------------------------------------------------------
// マスタ
// ---------------------------------------------------------------------------

/// 社内担当者
model Staff {
  id            String    @id @default(cuid())
  name          String
  /// 個人LINEへ通知する場合のユーザーID（Bot②と友だちである必要がある）
  lineUserId    String?   @unique
  email         String?   @unique
  role          StaffRole @default(STAFF)
  /// 責任者（エスカレーション先）
  managerId     String?
  manager       Staff?    @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  members       Staff[]   @relation("StaffManager")
  /// 通知を受け取るか
  notifyEnabled Boolean   @default(true)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customers    Customer[]
  sentMessages Message[]
  users        User[]
  linkCodes    StaffLinkCode[]
  followUpLogs FollowUpLog[]

  @@index([active])
  @@map("staff")
}

/// 担当者のLINEユーザーIDを本人操作で紐づけるための使い捨てコード。
/// 33文字のユーザーIDを手で書き写すと打ち間違いが起きるため、
/// 「管理画面で発行 → 本人が社内通知Botへ送信」で自動的に紐づける。
model StaffLinkCode {
  id               String    @id @default(cuid())
  staffId          String
  staff            Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// 平文は保存しない。照合はハッシュの完全一致で行う
  codeHash         String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  /// 誰が使ったか（監査用）
  usedByLineUserId String?
  createdAt        DateTime  @default(now())

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_link_codes")
}

/// 管理画面ログインユーザー
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             UserRole  @default(STAFF)
  staffId          String?
  staff            Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  active           Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

/// 顧客（LINEユーザー）
model Customer {
  id                      String   @id @default(cuid())
  /// LINE の userId（U から始まる33文字）。
  /// 電話・ポータル経由の反響は LINE 未連携のまま登録できるため null を許容する
  lineUserId              String?  @unique
  /// LINE プロフィール上の表示名
  displayName             String?
  /// 管理画面で編集できる顧客名（優先して表示される）
  name                    String?
  pictureUrl              String?
  note                    String?
  /// 担当者。null なら社内共通グループへ通知
  assigneeId              String?
  assignee                Staff?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// この顧客だけ通知間隔を上書きする（分）。null = 全体設定に従う / 0 = 通知しない
  reminderIntervalMinutes Int?
  /// ブロック（unfollow）されている
  blocked                 Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // --- 追客管理 -----------------------------------------------------------
  phone         String?
  email         String?
  /// 問い合わせ日時
  inquiredAt    DateTime?
  /// 問い合わせ経路（SUUMO / HOME'S / 自社HP / 電話 / 紹介 など）
  inquirySource String?
  /// 希望エリア
  desiredArea   String?
  /// 希望家賃（円 / 月）
  desiredRent   Int?
  /// 引越し希望時期（表示用の自由記述。例：9月中旬）
  moveInTiming  String?
  /// 引越し希望日。優先度の自動判定に使う（時期が近いほど優先）
  moveInBy      DateTime?
  /// 希望条件（間取り・設備など自由記述）
  requirements  String?

  status           CustomerStatus    @default(NEW_INQUIRY)
  /// 現在のステータスになった時刻。自動追客ルールの起点
  statusSince      DateTime          @default(now())
  /// 自動判定した追客優先度
  priority         FollowUpPriority  @default(B)
  /// 手動で固定した優先度。設定されていれば自動判定より優先する
  priorityOverride FollowUpPriority?

  /// 最終接触日時（こちらから接触した、または顧客から連絡があった時刻）
  lastContactAt     DateTime?
  /// 次回アクション日時。追客管理の中心【指示書 6】
  nextActionAt      DateTime?
  /// 次回アクションの種類
  nextActionType    ActionType?
  /// 次回アクションの内容（画面にそのまま出る文言）
  nextActionNote    String?
  /// 現在のステータス内で消化した追客ステップ番号
  followUpStep      Int         @default(0)
  /// 自動追客の対象にする。false にすると次回アクションを自動設定しない
  autoFollowEnabled Boolean     @default(true)

  contractedAt   DateTime?
  /// 成約金額（円）
  contractAmount Int?
  lostAt         DateTime?
  lostReason     String?
  /// 後から項目を追加できるようにするための自由項目
  customFields   Json?

  conversation Conversation?
  messages     Message[]
  reminders    Reminder[]
  followUpLogs FollowUpLog[]

  @@index([assigneeId])
  @@index([blocked])
  @@index([status])
  @@index([nextActionAt])
  @@index([assigneeId, nextActionAt])
  @@index([priority, nextActionAt])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// 中核：未返信状態機械
// ---------------------------------------------------------------------------

/// 顧客ごとに 1 行。未返信判定とリマインドスケジュールの単一の真実の源。
model Conversation {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  replyState     ReplyState     @default(REPLIED)
  handlingStatus HandlingStatus @default(DONE)

  /// 顧客からの最新メッセージ
  lastInboundAt        DateTime?
  lastInboundMessageId String?
  /// 通知本文に載せるための最新メッセージ抜粋
  lastInboundText      String?
  /// 担当者からの最新返信
  lastOutboundAt       DateTime?

  /// 【仕様①】リマインド経過時間のカウント起点。顧客の追加メッセージでリセットされる
  awaitingSince    DateTime?
  /// 【保険】直近の返信以降で最初に届いた未返信メッセージの時刻。追加メッセージではリセットしない。
  /// エスカレーション判定と「連投による通知先延ばし」防止に使う
  firstUnrepliedAt DateTime?

  reminderCount   Int       @default(0)
  lastReminderAt  DateTime?
  /// 次にリマインドを送るべき時刻。NULL = 送らない（返信済み / 通知OFF）
  nextReminderAt  DateTime?
  /// 既に発火したエスカレーション段階（EscalationRule.thresholdMinutes の最大値）
  escalationLevel Int       @default(0)

  resolvedAt   DateTime?
  resolvedVia  ResolvedVia?
  resolvedById String?

  /// 楽観ロック。管理画面の同時編集による上書き事故を防ぐ
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders Reminder[]

  /// Cron が期限到来分を引くための主索引
  @@index([nextReminderAt])
  @@index([replyState, nextReminderAt])
  @@index([handlingStatus])
  @@index([awaitingSince])
  @@map("conversations")
}

/// 送受信メッセージの全ログ
model Message {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId String?

  direction     Direction
  /// LINE 側のメッセージID。Webhook 再送の冪等性担保に使う
  lineMessageId String?   @unique
  messageType   String    @default("text")
  text          String?
  sentAt        DateTime
  /// 送信した担当者（OUTBOUND のみ）
  sentByStaffId String?
  sentByStaff   Staff?    @relation(fields: [sentByStaffId], references: [id], onDelete: SetNull)
  /// LINE_WEBHOOK / ADMIN_CONSOLE / INGEST_API / MANUAL
  source        String
  raw           Json?
  createdAt     DateTime  @default(now())

  @@index([customerId, sentAt])
  @@index([conversationId, sentAt])
  @@index([direction, sentAt])
  @@map("messages")
}

/// 送信した（または送信しようとした）リマインドの記録。二重通知防止の要。
model Reminder {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  kind     ReminderKind
  /// この未返信サイクル内での通知回数（1始まり）
  sequence Int

  /// 【二重通知防止】同一サイクル・同一段階の通知を物理的に1件に制限する冪等キー
  dedupeKey String @unique

  scheduledFor     DateTime
  /// 通知時点の未返信経過（分）
  unrepliedMinutes Int
  status           ReminderStatus @default(PENDING)
  attempts         Int            @default(0)
  /// 解決済みの通知先（チャネル種別・宛先・担当者名）
  targets          Json
  /// 実際に送った本文（監査用）
  bodyText         String
  sentAt           DateTime?
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([conversationId, createdAt])
  @@index([status, scheduledFor])
  @@index([createdAt])
  @@map("reminders")
}

// ---------------------------------------------------------------------------
// 設定
// ---------------------------------------------------------------------------

/// シングルトン設定（id = 1 固定）
model AppSettings {
  id       Int    @id @default(1)
  timezone String @default("Asia/Tokyo")

  /// 既定のリマインド間隔（分）。60 / 120 / 180 / 0=通知しない
  defaultReminderIntervalMinutes Int @default(60)
  /// 初回リマインドまでの待ち時間（分）
  firstReminderDelayMinutes      Int @default(60)
  /// 1サイクルあたりの最大通知回数（0 = 無制限）
  maxRemindersPerCycle           Int @default(0)

  /// 営業時間。{"mon":{"enabled":true,"open":"09:00","close":"20:00"}, ...}
  businessHours          Json
  /// 営業時間を尊重する（false なら24時間通知）
  respectBusinessHours   Boolean @default(true)
  /// 祝日も営業する
  openOnPublicHolidays   Boolean @default(false)
  /// 経過時間を営業時間のみでカウントする（false = 実時間）
  countBusinessHoursOnly Boolean @default(false)

  /// リマインドの間隔を回を追うごとに倍にする（1h→2h→4h→8h）。
  /// LINEの通数はライトプランで上限に達すると送信できなくなるため、
  /// 同じ内容を鳴らし続けるより間隔を空けて長く鳴らすほうが目的に合う。
  reminderBackoffEnabled     Boolean @default(true)
  /// バックオフの上限（分）。これ以上は間隔を広げない。0 = 上限なし
  maxReminderIntervalMinutes Int     @default(480)

  /// LINE公式アカウントの月間無料メッセージ通数（ライトプラン = 5,000）。
  /// 「あと何通で止まるか」を出すためだけに使う値で、送信は止めない。
  lineMonthlyFreeQuota Int @default(5000)

  /// 【保険】firstUnrepliedAt からこの分数を超えたら、起点リセットに関係なく強制通知
  maxSilenceGuardMinutes Int @default(180)
  /// 配信予定を過ぎてこの分数以上滞留したら異常とみなし要確認＋管理者通知
  watchdogDelayMinutes   Int @default(20)

  /// 担当者が設定されていても、社内共通の通知先へ必ず同報する。
  /// 担当者以外（事務など）が返信することがあるため、既定で有効。
  alwaysNotifyDefaultGroup Boolean @default(true)

  /// 2回目以降のリマインドを1通にまとめて送る。
  /// 問い合わせが多いと1件1通では社内LINEが埋まり、かえって見落とすため。
  /// 初回とエスカレーションは、ボタン付きの個別通知のまま。
  digestRepeatReminders Boolean @default(true)

  /// リマインド本文のテンプレート。空なら既定の文面を使う。
  /// {顧客名} {担当者} {経過時間} などを差し込める。
  notificationTemplate String?

  /// 通知本文に顧客メッセージを含めるか
  includeMessageBodyInNotification Boolean @default(true)
  /// 通知本文に載せるメッセージの最大文字数
  messageExcerptLength             Int     @default(60)

  /// メッセージ保持期間（月）。0 = 無期限
  dataRetentionMonths Int @default(24)

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// LINEの消費通数の実測記録。
///
/// ライトプランは無料通数を超えると **送信そのものができなくなる**（追加購入不可）。
/// つまり枯渇＝リマインドの停止であり、「あと何通か」を推測で運用してはいけない。
/// 送信に成功した分だけを1件ずつ残し、実測で残量と月末予測を出す。
///
/// 記録は dispatcher で行う。未返信リマインドも追客通知もテスト送信も
/// 同じチャネルの通数を食うため、送信の出口で数えないと必ず取りこぼす。
model MessageUsage {
  id      String      @id @default(cuid())
  sentAt  DateTime    @default(now())
  channel ChannelType
  /// 宛先（groupId / userId / URL）。どこ宛てが効いているかを後から追える
  target  String
  /// この送信で消費した通数。グループは人数分、Webhookは0
  units   Int
  /// 何の通知か（REMINDER / FOLLOWUP / WATCHDOG / TEST / OTHER）
  purpose String

  @@index([sentAt])
  @@map("message_usage")
}

/// 祝日・臨時休業日 / 臨時営業日
model BusinessHoliday {
  id     String   @id @default(cuid())
  /// 対象日（タイムゾーンは AppSettings.timezone 基準の暦日）
  date   DateTime @unique @db.Date
  name   String
  /// true にすると「祝日だがこの日は営業する」臨時営業日として扱う
  isOpen Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([date])
  @@map("business_holidays")
}

/// エスカレーション設定
model EscalationRule {
  id               String   @id @default(cuid())
  name             String
  /// 未返信がこの分数を超えたら発火（firstUnrepliedAt 基準）
  thresholdMinutes Int      @unique
  notifyAssignee   Boolean  @default(true)
  notifyManager    Boolean  @default(false)
  notifyAdmins     Boolean  @default(false)
  notifyGroup      Boolean  @default(false)
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled, thresholdMinutes])
  @@map("escalation_rules")
}

/// 社内通知チャネル
model NotificationChannel {
  id          String         @id @default(cuid())
  name        String
  type        ChannelType
  /// LINE の groupId / userId、または Webhook URL
  target      String
  purpose     ChannelPurpose @default(DEFAULT_GROUP)
  /// LINEグループの人数。通数は「送信回数 × 届いた人数」で数えるため、
  /// これが分からないと実際の消費通数を出せない。個人宛て・Webhookでは使わない
  memberCount Int?
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([purpose, enabled])
  @@map("notification_channels")
}

// ---------------------------------------------------------------------------
// 冪等性・監査
// ---------------------------------------------------------------------------

/// LINE Webhook の冪等性担保。再送された同一イベントを無視するために使う
model WebhookEvent {
  id             String    @id @default(cuid())
  webhookEventId String    @unique
  eventType      String
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  isRedelivery   Boolean   @default(false)
  raw            Json

  @@index([receivedAt])
  @@map("webhook_events")
}

/// 操作監査ログ
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Cron の死活記録（外部監視から参照する）
/// Webhook 受け口に届いたリクエストの受信記録。
///
/// 「入口が詰まっていることに気づけない」のが、このシステムで一番怖い壊れ方。
/// Lステップの転送が止まっても、設定を間違えても、外形上はただ静かになるだけで
/// 未返信の検知が丸ごと止まる。ホスティング事業者のログを掘らないと分からない、
/// という状態にはしない。管理画面から直接見えるところに残す。
///
/// 本文は保存しない。届いたかどうかと、なぜ弾いたか（または何件取り出せたか）だけを持つ。
model RelayReceipt {
  id         String   @id @default(cuid())
  receivedAt DateTime @default(now())
  /// 受け口の種類。'RELAY'（Lステップ転送） / 'WEBHOOK'（LINEから直接）
  endpoint   String
  /// 受理できたか
  accepted   Boolean
  /// 受理の経路（LINE_SIGNATURE / RELAY_TOKEN）または拒否理由（BAD_TOKEN 等）
  detail     String
  /// 取り出せたイベント数。受理できなかった場合は 0
  eventCount Int      @default(0)
  /// 届いたJSONの「形」だけ（値は含まない）。転送形式が想定外だったときの手がかり
  shape      String?

  @@index([receivedAt])
  @@map("relay_receipts")
}

model CronRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  claimed    Int       @default(0)
  sent       Int       @default(0)
  skipped    Int       @default(0)
  failed     Int       @default(0)
  error      String?

  @@index([job, startedAt])
  @@map("cron_runs")
}

// ===========================================================================
//  追客管理（自動追客システム）
//  「営業マンが顧客管理をする」のではなく「システムが追客を管理し、
//   営業マンには今日やるべき営業だけを提示する」ためのモデル群。
//  設計意図の詳細は docs/10-followup-design.md を参照
// ===========================================================================

/// 顧客の営業進捗ステータス。
/// 営業マンに細かく入力させず、行動・経過時間・顧客の反応から極力自動で遷移させる。
enum CustomerStatus {
  NEW_INQUIRY /// 新規反響
  FIRST_CONTACTED /// 初回対応済
  HEARING_DONE /// ヒアリング済
  PROPOSING /// 物件提案中
  AWAITING_QUOTE /// 見積書待ち
  VIEWING_ARRANGING /// 内見調整中
  VIEWED /// 内見済
  APPLICATION_REVIEW /// 申込検討
  APPLIED /// 申込済
  CONTRACTED /// 成約
  ON_HOLD /// 保留
  NO_REPLY /// 返信なし
  LOST /// 失注
  DORMANT /// 休眠
}

/// 追客優先度。S=今すぐ / A=今日 / B=通常 / C=自動追客
enum FollowUpPriority {
  S
  A
  B
  C
}

/// 次回アクションの種類。営業マンの「大きなボタン」と1対1に対応する
enum ActionType {
  LINE /// LINEする
  CALL /// 電話する
  PROPOSE /// 物件を提案
  VIEWING /// 内見設定
  QUOTE /// 見積書を依頼
  MEETING /// 来店・面談
  SYSTEM /// システム処理（休眠化などの自動遷移。営業マンには出さない）
  OTHER /// その他
}

/// 追客履歴をどの経路で記録したか
enum FollowUpSource {
  MANUAL /// 営業マンが画面で記録した
  ADMIN_REPLY /// 管理画面からLINE送信した
  AUTO /// 自動追客ルールによるシステム処理
  LINE_INBOUND /// 顧客からのLINE受信
  LINE_OUTBOUND /// 顧客へのLINE送信（外部経路の取り込み含む）
}

/// 自動追客ルール。ステータスごとに「何日後に何をするか」を順番に並べたもの。
/// 次回アクションは (ステータス開始時刻 + offsetMinutes) で決まるため、
/// 営業マンが次回追客日を手入力する必要がない。【指示書 6・10】
model FollowUpRule {
  id            String          @id @default(cuid())
  status        CustomerStatus
  /// 同一ステータス内での順番（0始まり）
  step          Int
  /// ステータス開始（statusSince）からの経過分数
  offsetMinutes Int
  actionType    ActionType
  /// 次回アクション内容として画面に出す文言
  label         String
  /// 使用するLINEテンプレートのキー（MessageTemplate.key）
  templateKey   String?
  /// この段階に到達したら営業マンへ社内通知する（例：見積書待ち72時間）
  notifyStaff   Boolean         @default(false)
  /// この段階に到達したら自動でこのステータスへ遷移させる（例：返信なし30日 → 休眠）
  transitionTo  CustomerStatus?
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([status, step])
  @@index([status, enabled])
  @@map("follow_up_rules")
}

/// 追客履歴。「いつ・誰が・何をしたか」の全記録。
/// 営業マンの手入力ではなく、ボタン操作とシステム処理から自動的に積み上がる。
model FollowUpLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  actionType   ActionType
  source       FollowUpSource  @default(MANUAL)
  /// 対応結果（応答あり / 不在 / 送信のみ など）
  result       String?
  note         String?
  statusBefore CustomerStatus?
  statusAfter  CustomerStatus?
  /// 予定していた次回アクション日時。期限超過で対応したかの分析に使う
  scheduledFor DateTime?
  occurredAt   DateTime        @default(now())
  /// 自動処理の二重実行を物理的に防ぐ冪等キー（手動記録では null）
  dedupeKey    String?         @unique
  createdAt    DateTime        @default(now())

  @@index([customerId, occurredAt])
  @@index([occurredAt])
  @@index([staffId, occurredAt])
  @@map("follow_up_logs")
}

/// LINE送信テンプレート。営業マンに文章を考えさせないための候補文。
/// 将来のAI生成に置き換えられるよう、選択と送信の経路を分けてある。【指示書 9】
model MessageTemplate {
  id         String          @id @default(cuid())
  key        String          @unique
  title      String
  /// 本文。{{name}} {{assignee}} {{area}} {{rent}} を差し込める
  body       String
  /// この状況のときに候補として優先表示する
  status     CustomerStatus?
  actionType ActionType?
  sortOrder  Int             @default(0)
  enabled    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, enabled])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// 業務システムポータル
// ---------------------------------------------------------------------------

/// ポータルのトップページに並べる業務システム 1 件。
///
/// 設計上の要点は「遷移先URLをコードに書かない」こと。
/// 各システムの引っ越しやドメイン変更のたびにデプロイし直すのは現実的でないため、
/// URL・アイコン・説明・表示順・公開状態はすべてこの表で管理し、
/// 管理画面から変更したら次の表示から反映されるようにしている。
///
/// 新しいシステムが増えてもコード修正は不要（行を足すだけ）。
model PortalSystem {
  id           String   @id @default(cuid())
  name         String
  /// カードに大きく出すアイコン（絵文字）
  icon         String   @default("🔗")
  /// カードの色。Tailwind のクラス名はコード側の対応表で解決する
  accent       String   @default("slate")
  description  String?
  /// 遷移先。https:// の絶対URL、または同一サイト内の /path
  url          String
  /// 別タブで開くか（外部システムは既定で別タブ）
  openInNewTab Boolean  @default(true)
  /// 表示順。小さいほど先に出る
  sortOrder    Int      @default(0)
  /// 非公開にするとトップページから消える（削除ではないので後から戻せる）
  published    Boolean  @default(true)
  /// このシステムを開ける最低権限。将来のシステム別アクセス権限の土台
  minRole      UserRole @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("portal_systems")
}

// ===========================================================================
//  Company OS — 会社の立ち上げから経営までを一元管理する
//
//  既存の追客システムとは同じデータベースを共有するが、テーブルは co_ 接頭辞で
//  完全に分けている。相互参照は行っていないため、片方だけを止めても壊れない。
//  設計意図の詳細は docs/14-company-os.md を参照。
// ===========================================================================

/// 会社内での権限。数値順の強さはコード側（lib/company-os/access.ts）で持つ
enum CoRole {
  OWNER /// 経営者。すべてを見て、すべてを決められる
  ADMIN /// 管理者。設定変更まで可能
  MANAGER /// 責任者。担当領域の実務を回す
  MEMBER /// 一般メンバー
  VIEWER /// 閲覧のみ
}

/// 会社の段階。ダッシュボードで「次に何をすべきか」を変えるために使う
enum CoStage {
  IDEA /// 構想中
  PREPARING /// 設立準備中
  ESTABLISHED /// 設立済み
  GROWING /// 成長期
  ACQUIRED /// 買収した会社
}

enum CoTaskStatus {
  TODO /// 未着手
  IN_PROGRESS /// 進行中
  REVIEW /// 確認待ち
  DONE /// 完了
  ON_HOLD /// 保留
  CANCELED /// 中止
}

enum CoPriority {
  TOP /// 最優先
  HIGH /// 高
  MEDIUM /// 中
  LOW /// 低
}

/// タスク・課題・書類を横断で束ねる領域。サイドバーの大分類と対応する
enum CoArea {
  COMPANY /// 会社設立
  LEGAL /// 法務
  MANAGEMENT /// 経営
  BUSINESS /// 事業・商品
  SALES /// 営業
  CUSTOMER /// 顧客
  DEVELOPMENT /// 開発
  SUBSIDY /// 補助金
  MA /// M&A
  FINANCE /// 財務
  HR /// 人事・組織
  OTHER /// その他
}

enum CoProjectStatus {
  PLANNING /// 計画中
  ACTIVE /// 進行中
  ON_HOLD /// 保留
  DONE /// 完了
  CANCELED /// 中止
}

enum CoIssueStatus {
  OPEN /// 未対応
  INVESTIGATING /// 調査中
  ACTING /// 対策中
  RESOLVED /// 解決
  ON_HOLD /// 保留
}

enum CoSeverity {
  CRITICAL /// 経営に直結する
  HIGH /// 重要
  MEDIUM /// 中
  LOW /// 低
}

/// 未決事項の状態
enum CoQuestionStatus {
  OPEN /// 未着手
  DISCUSSING /// 検討中
  DECIDED /// 決定済み（意思決定へ転記済み）
  DEFERRED /// 保留
}

enum CoObjectiveStatus {
  ON_TRACK /// 順調
  AT_RISK /// 黄信号
  OFF_TRACK /// 未達見込み
  ACHIEVED /// 達成
  DROPPED /// 取り下げ
}

/// 情報の公開範囲。経営者だけが見る情報を分けるために使う
enum CoVisibility {
  ALL /// 全員
  MANAGERS /// 責任者以上
  OWNERS /// 経営者・管理者のみ
}

// ---------------------------------------------------------------------------
// 会社
// ---------------------------------------------------------------------------

/// 経営の単位。買収した会社も1レコードとして並べて管理できる
model CoCompany {
  id              String    @id @default(cuid())
  name            String
  /// 登記上の商号（未定なら空。設立前は name に仮称を入れる運用）
  legalName       String?
  stage           CoStage   @default(IDEA)
  /// 事業目的（定款に書く内容の下書きを兼ねる）
  purpose         String?
  /// 何のための会社か。ダッシュボードの一番上に出す
  vision          String?
  industry        String?
  foundedOn       DateTime? @db.Date
  /// 資本金（円）
  capital         BigInt?
  /// 決算月（1-12）
  fiscalMonth     Int?
  /// 法人番号（13桁）
  corporateNumber String?
  address         String?
  phone           String?
  website         String?
  notes           String?
  /// 会社を切り替えたときの並び順
  sortOrder       Int       @default(0)
  archived        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      CoMember[]
  shareholders CoShareholder[]
  projects     CoProject[]
  tasks        CoTask[]
  issues       CoIssue[]
  decisions    CoDecision[]
  questions    CoQuestion[]
  meetings     CoMeeting[]
  documents    CoDocument[]
  objectives   CoObjective[]

  @@index([archived, sortOrder])
  @@map("co_companies")
}

/// 会社に属する人。ログインアカウント（User）が無い共同創業者も登録できる
model CoMember {
  id         String    @id @default(cuid())
  companyId  String
  company    CoCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// ログインアカウントとの紐付け。未ログインの関係者は null のまま
  userId     String?
  name       String
  email      String?
  role       CoRole    @default(MEMBER)
  /// 役職（代表取締役 / 取締役 など）
  title      String?
  /// 部署・担当領域
  department String?
  /// 役員かどうか（役員一覧に出す）
  isOfficer  Boolean   @default(false)
  note       String?
  active     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTasks   CoTask[]      @relation("CoTaskAssignee")
  ownedProjects   CoProject[]   @relation("CoProjectOwner")
  ownedIssues     CoIssue[]     @relation("CoIssueOwner")
  ownedQuestions  CoQuestion[]  @relation("CoQuestionOwner")
  ownedObjectives CoObjective[] @relation("CoObjectiveOwner")
  decisions       CoDecision[]  @relation("CoDecisionDecider")
  comments        CoComment[]

  @@unique([companyId, userId])
  @@index([companyId, active])
  @@map("co_members")
}

/// 株主構成。設立時の出資比率をそのまま残す
model CoShareholder {
  id        String    @id @default(cuid())
  companyId String
  company   CoCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  /// 個人 / 法人
  isCompany Boolean   @default(false)
  /// 保有株式数
  shares    Int?
  /// 出資比率（%）。株式数が未定の段階でも比率だけ決められる
  ratio     Float?
  /// 出資額（円）
  amount    BigInt?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("co_shareholders")
}

// ---------------------------------------------------------------------------
// プロジェクト / タスク
// ---------------------------------------------------------------------------

/// 会社の大きな仕事の単位（会社立ち上げ・会社買収・営業開始 など）
model CoProject {
  id               String          @id @default(cuid())
  companyId        String
  company          CoCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  status           CoProjectStatus @default(PLANNING)
  area             CoArea          @default(OTHER)
  priority         CoPriority      @default(MEDIUM)
  ownerId          String?
  owner            CoMember?       @relation("CoProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  startOn          DateTime?       @db.Date
  dueOn            DateTime?       @db.Date
  /// 手入力の進捗率。null ならタスクの完了率から算出する
  progressOverride Int?
  color            String          @default("slate")
  sortOrder        Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      CoTask[]
  milestones CoMilestone[]
  issues     CoIssue[]
  decisions  CoDecision[]
  questions  CoQuestion[]
  documents  CoDocument[]

  @@index([companyId, status, sortOrder])
  @@map("co_projects")
}

/// プロジェクトの節目。ガント／タイムライン表示の基準線になる
model CoMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   CoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  dueOn     DateTime? @db.Date
  done      Boolean   @default(false)
  doneAt    DateTime?
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@map("co_milestones")
}

/// 実行の最小単位。会社運営の中心
model CoTask {
  id          String       @id @default(cuid())
  companyId   String
  company     CoCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      CoTaskStatus @default(TODO)
  priority    CoPriority   @default(MEDIUM)
  area        CoArea       @default(OTHER)

  projectId  String?
  project    CoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   CoMember?  @relation("CoTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// この課題を解決するためのタスク
  issueId    String?
  issue      CoIssue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  /// この会議で発生したタスク
  meetingId  String?
  meeting    CoMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  startOn     DateTime? @db.Date
  dueOn       DateTime? @db.Date
  completedAt DateTime?

  /// 関連顧客・関連会社は自由記述。CRM（Phase2）が入ったら参照に置き換える
  relatedCustomer String?
  relatedParty    String?

  /// 優先順位の算出に使う経営インパクト（0=なし 1=小 2=中 3=大）
  revenueImpact Int @default(0)
  riskImpact    Int @default(0)

  /// テンプレートから生成したタスクの識別子。二重生成を防ぐ
  templateKey String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist    CoChecklistItem[]
  comments     CoComment[]
  documents    CoDocument[]
  /// このタスクが待っている先行タスク
  dependencies CoTaskDependency[] @relation("CoTaskDependent")
  /// このタスクの完了を待っている後続タスク
  dependents   CoTaskDependency[] @relation("CoTaskBlocker")

  @@unique([companyId, templateKey])
  @@index([companyId, status, dueOn])
  @@index([companyId, assigneeId, status])
  @@index([projectId, sortOrder])
  @@map("co_tasks")
}

/// タスクの依存関係（taskId は dependsOnId の完了を待つ）
model CoTaskDependency {
  id          String @id @default(cuid())
  taskId      String
  task        CoTask @relation("CoTaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   CoTask @relation("CoTaskBlocker", fields: [dependsOnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("co_task_dependencies")
}

model CoChecklistItem {
  id        String  @id @default(cuid())
  taskId    String
  task      CoTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, sortOrder])
  @@map("co_checklist_items")
}

/// タスク・課題へのコメント。どちらか一方に必ず紐づく
model CoComment {
  id         String    @id @default(cuid())
  taskId     String?
  task       CoTask?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId    String?
  issue      CoIssue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId   String?
  author     CoMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// 投稿時点の名前。メンバーを消しても誰の発言か分かるようにする
  authorName String
  body       String

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([issueId, createdAt])
  @@map("co_comments")
}

// ---------------------------------------------------------------------------
// 経営
// ---------------------------------------------------------------------------

/// 経営課題。「起きている問題」を放置しないための台帳
model CoIssue {
  id        String        @id @default(cuid())
  companyId String
  company   CoCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  detail    String?
  severity  CoSeverity    @default(MEDIUM)
  status    CoIssueStatus @default(OPEN)
  area      CoArea        @default(MANAGEMENT)

  occurredOn DateTime? @db.Date
  dueOn      DateTime? @db.Date
  resolvedAt DateTime?

  ownerId   String?
  owner     CoMember?  @relation("CoIssueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectId String?
  project   CoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingId String?
  meeting   CoMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  /// 原因
  cause          String?
  /// 対策
  countermeasure String?
  /// 次のアクション（タスク化していない段階の一文）
  nextAction     String?

  visibility CoVisibility @default(ALL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     CoTask[]
  comments  CoComment[]
  decisions CoDecision[]

  @@index([companyId, status, severity])
  @@map("co_issues")
}

/// 意思決定。「何を決めたか」を消さずに残す
model CoDecision {
  id          String       @id @default(cuid())
  companyId   String
  company     CoCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  /// 背景
  background  String?
  /// そう決めた理由
  reason      String?
  decidedOn   DateTime     @db.Date
  deciderId   String?
  decider     CoMember?    @relation("CoDecisionDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  /// 決定者の表示名。メンバー未登録でも記録できるようにする
  deciderName String?
  area        CoArea       @default(MANAGEMENT)
  /// ダッシュボードに出す重要な決定
  important   Boolean      @default(false)
  visibility  CoVisibility @default(ALL)

  projectId String?
  project   CoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issueId   String?
  issue     CoIssue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  meetingId String?
  meeting   CoMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions CoDecisionRevision[]
  questions CoQuestion[]

  @@index([companyId, decidedOn])
  @@map("co_decisions")
}

/// 決定の変更履歴。「いつ、何が、なぜ変わったか」を追えるようにする
model CoDecisionRevision {
  id         String     @id @default(cuid())
  decisionId String
  decision   CoDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  /// 変更内容の要約
  summary    String
  /// 変更前の本文（title / background / reason をまとめた文字列）
  before     String?
  changedBy  String?

  createdAt DateTime @default(now())

  @@index([decisionId, createdAt])
  @@map("co_decision_revisions")
}

/// 未決事項。「まだ決まっていないこと」を見える場所に置く
model CoQuestion {
  id             String           @id @default(cuid())
  companyId      String
  company        CoCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  /// 論点
  point          String?
  /// 選択肢。[{ "label": "...", "pros": "...", "cons": "..." }]
  options        Json             @default("[]")
  /// 推奨案
  recommendation String?
  status         CoQuestionStatus @default(OPEN)
  severity       CoSeverity       @default(MEDIUM)
  area           CoArea           @default(MANAGEMENT)
  dueOn          DateTime?        @db.Date

  ownerId    String?
  owner      CoMember?   @relation("CoQuestionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectId  String?
  project    CoProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingId  String?
  meeting    CoMeeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// 決まったときに作られた意思決定
  decisionId String?
  decision   CoDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status, dueOn])
  @@map("co_questions")
}

/// 会議ログ。決定事項・未決事項・タスクの発生源
model CoMeeting {
  id         String       @id @default(cuid())
  companyId  String
  company    CoCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title      String
  heldAt     DateTime
  /// 参加者（表示名の配列）
  attendees  Json         @default("[]")
  /// 議題
  agenda     String?
  /// 議事録の本文
  minutes    String?
  visibility CoVisibility @default(ALL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     CoTask[]
  issues    CoIssue[]
  decisions CoDecision[]
  questions CoQuestion[]

  @@index([companyId, heldAt])
  @@map("co_meetings")
}

/// 経営目標とKPI。目標値と現在値を並べて達成度を出す
model CoObjective {
  id           String            @id @default(cuid())
  companyId    String
  company      CoCompany         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  /// KPI として数値で追うか（false なら定性目標）
  isKpi        Boolean           @default(false)
  targetValue  Float?
  currentValue Float?
  /// 単位（円 / 件 / 社 / % など）
  unit         String?
  status       CoObjectiveStatus @default(ON_TRACK)
  area         CoArea            @default(MANAGEMENT)
  periodLabel  String?
  /// ダッシュボードの経営数値カードと結びつける鍵（revenue_month など）。
  /// 会社ごとに一意。財務モジュール（Phase2）が入るまでは、ここが唯一の数値の置き場になる
  metricKey    String?
  dueOn        DateTime?         @db.Date
  ownerId      String?
  owner        CoMember?         @relation("CoObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sortOrder    Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, metricKey])
  @@index([companyId, sortOrder])
  @@map("co_objectives")
}

/// 重要書類・関連資料。実体は外部ストレージに置き、ここでは場所と期限だけ持つ
model CoDocument {
  id         String       @id @default(cuid())
  companyId  String
  company    CoCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  /// 保管場所（URL、または「金庫」「税理士預かり」などの文字列）
  location   String?
  area       CoArea       @default(COMPANY)
  note       String?
  /// 更新期限・満了日。法務の重要期限として一覧に出す
  expiresOn  DateTime?    @db.Date
  visibility CoVisibility @default(ALL)

  projectId String?
  project   CoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      CoTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, area])
  @@map("co_documents")
}
