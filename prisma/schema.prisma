// ===========================================================================
//  Retail vs Large Trader Sentiment Dashboard — データベーススキーマ
//
//  MVP では Provider から取得した値をそのまま表示しており、この DB は
//  「履歴を貯めて 1h / 24h 変化や週次推移を出す」ための保存先として定義してある。
//  実データ Provider を接続する段階で、取得 → 保存 → 表示の順に切り替える。
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketCategory {
  FX
  METAL
  CRYPTO
  INDEX
}

enum Bias {
  LONG
  SHORT
  NEUTRAL
}

enum MarketStatus {
  ALIGNED_LONG
  ALIGNED_SHORT
  DIVERGENCE
  NEUTRAL
  DATA_UNAVAILABLE
}

/// 表示対象の銘柄
model Market {
  id       Int            @id @default(autoincrement())
  symbol   String         @unique
  slug     String         @unique
  name     String
  category MarketCategory
  enabled  Boolean        @default(true)

  retailSentiment RetailSentiment[]
  largeTrader     LargeTraderPosition[]
  prices          MarketPrice[]
  alignments      AlignmentScore[]

  @@map("markets")
}

/// 個人トレーダーのポジション比率 (提供元ごとに 1 行)
model RetailSentiment {
  id           BigInt   @id @default(autoincrement())
  marketId     Int      @map("market_id")
  provider     String
  longPercent  Decimal  @map("long_percent") @db.Decimal(5, 2)
  shortPercent Decimal  @map("short_percent") @db.Decimal(5, 2)
  timestamp    DateTime

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, provider, timestamp])
  @@index([marketId, timestamp])
  @@map("retail_sentiment")
}

/// 大口 (Large Trader / Institutional proxy) の建玉。CFTC は週次。
model LargeTraderPosition {
  id            BigInt   @id @default(autoincrement())
  marketId      Int      @map("market_id")
  provider      String
  /// CFTC TFF の分類 (Leveraged Funds など)
  traderCategory String  @map("trader_category")
  longPosition  BigInt   @map("long_position")
  shortPosition BigInt   @map("short_position")
  netPosition   BigInt   @map("net_position")
  timestamp     DateTime

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, provider, traderCategory, timestamp])
  @@index([marketId, timestamp])
  @@map("large_trader_positions")
}

/// 価格
model MarketPrice {
  id        BigInt   @id @default(autoincrement())
  marketId  Int      @map("market_id")
  provider  String
  price     Decimal  @db.Decimal(18, 8)
  timestamp DateTime

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, provider, timestamp])
  @@index([marketId, timestamp])
  @@map("market_prices")
}

/// 判定結果のスナップショット
model AlignmentScore {
  id        BigInt       @id @default(autoincrement())
  marketId  Int          @map("market_id")
  score     Int
  bias      Bias
  status    MarketStatus
  timestamp DateTime

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, timestamp])
  @@map("alignment_scores")
}
