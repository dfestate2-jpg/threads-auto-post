// ===========================================================================
//  公式LINE 未返信リマインドシステム — データベーススキーマ
//  設計意図の詳細は docs/03-database-design.md を参照
// ===========================================================================

generator client {
  provider      = "prisma-client-js"
  /**
   * ビルドは Linux(Debian) 上で行われるが、Netlify Functions の実行環境は
   * AWS Lambda(Amazon Linux) である。native だけだと実行時に
   * 「Query engine binary for current platform could not be found」で落ちるため、
   * 実行環境用のエンジンも一緒に生成しておく。
   */
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // アプリ実行時の接続。サーバーレスでは接続数を抑えるためプーラー経由にする
  url       = env("DATABASE_URL")
  // マイグレーション実行時の接続。
  // Supabase の Transaction pooler(6543) は Prisma migrate が使う
  // アドバイザリロックに対応していないため、別経路を指定できるようにしている。
  // プーラーを使わない環境では DATABASE_URL と同じ値を入れてよい。
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// メッセージの向き
enum Direction {
  INBOUND /// 顧客 → 公式LINE
  OUTBOUND /// 公式LINE → 顧客（担当者の返信）
}

/// 未返信状態機械（システムが自動判定する内部状態）
enum ReplyState {
  AWAITING /// 未返信（顧客の最新メッセージ > 担当者の最新返信）
  REPLIED /// 返信済み
}

/// 管理画面で人が管理する対応状況
enum HandlingStatus {
  UNHANDLED /// 未対応
  IN_PROGRESS /// 対応中
  DONE /// 対応済み
  NEEDS_CHECK /// 要確認
}

enum StaffRole {
  STAFF /// 担当者
  MANAGER /// 責任者
  ADMIN /// 管理者
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

/// リマインドの種別
enum ReminderKind {
  ROUTINE /// 通常の定期リマインド
  ESCALATION /// 閾値超過によるエスカレーション
  GUARD /// 連投による起点リセットを打ち消す保険通知
  WATCHDOG /// 配信遅延検知（システム異常の通知）
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED /// 確保後、送信直前の再判定で「返信済み」と判明したため中止
}

/// 通知チャネル種別
enum ChannelType {
  LINE_GROUP /// LINE Messaging API push（グループ宛）
  LINE_USER /// LINE Messaging API push（個人宛）
  WEBHOOK /// 汎用 Webhook（Slack / Discord / LINE WORKS 等）
}

/// 通知チャネルの役割
enum ChannelPurpose {
  DEFAULT_GROUP /// 社内共通の通知先。担当者未設定時の受け皿であり、同報先でもある
  ADMIN /// 管理者向け（エスカレーション最終段・watchdog）
  FALLBACK /// 主経路が連続失敗したときの代替
}

/// 「返信済み」と判定した経路
enum ResolvedVia {
  ADMIN_REPLY /// 管理画面から返信を送信した
  MANUAL /// 管理画面で「対応済み」に変更した
  INGEST_API /// 外部連携から返信を取り込んだ
  WEBHOOK /// LINE Webhook 由来の送信イベント（Module Channel 等）
  LINE_POSTBACK /// 社内LINE通知の「対応済みにする」ボタンをタップした
}

// ---------------------------------------------------------------------------
// マスタ
// ---------------------------------------------------------------------------

/// 社内担当者
model Staff {
  id            String    @id @default(cuid())
  name          String
  /// 個人LINEへ通知する場合のユーザーID（Bot②と友だちである必要がある）
  lineUserId    String?   @unique
  email         String?   @unique
  role          StaffRole @default(STAFF)
  /// 責任者（エスカレーション先）
  managerId     String?
  manager       Staff?    @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  members       Staff[]   @relation("StaffManager")
  /// 通知を受け取るか
  notifyEnabled Boolean   @default(true)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customers    Customer[]
  sentMessages Message[]
  users        User[]
  linkCodes    StaffLinkCode[]

  @@index([active])
  @@map("staff")
}

/// 担当者のLINEユーザーIDを本人操作で紐づけるための使い捨てコード。
/// 33文字のユーザーIDを手で書き写すと打ち間違いが起きるため、
/// 「管理画面で発行 → 本人が社内通知Botへ送信」で自動的に紐づける。
model StaffLinkCode {
  id               String    @id @default(cuid())
  staffId          String
  staff            Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// 平文は保存しない。照合はハッシュの完全一致で行う
  codeHash         String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  /// 誰が使ったか（監査用）
  usedByLineUserId String?
  createdAt        DateTime  @default(now())

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_link_codes")
}

/// 管理画面ログインユーザー
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             UserRole  @default(STAFF)
  staffId          String?
  staff            Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  active           Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaigns Campaign[]

  @@map("users")
}

/// 顧客（LINEユーザー）
model Customer {
  id                      String   @id @default(cuid())
  /// LINE の userId（U から始まる33文字）
  lineUserId              String   @unique
  /// LINE プロフィール上の表示名
  displayName             String?
  /// 管理画面で編集できる顧客名（優先して表示される）
  name                    String?
  pictureUrl              String?
  note                    String?
  /// 担当者。null なら社内共通グループへ通知
  assigneeId              String?
  assignee                Staff?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// この顧客だけ通知間隔を上書きする（分）。null = 全体設定に従う / 0 = 通知しない
  reminderIntervalMinutes Int?
  /// ブロック（unfollow）されている
  blocked                 Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  conversation Conversation?
  messages     Message[]
  reminders    Reminder[]
  /// 一斉配信の配信先（メール等）。LINE の反応でセグメントするために紐づける
  contact      Contact?

  @@index([assigneeId])
  @@index([blocked])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// 中核：未返信状態機械
// ---------------------------------------------------------------------------

/// 顧客ごとに 1 行。未返信判定とリマインドスケジュールの単一の真実の源。
model Conversation {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  replyState     ReplyState     @default(REPLIED)
  handlingStatus HandlingStatus @default(DONE)

  /// 顧客からの最新メッセージ
  lastInboundAt        DateTime?
  lastInboundMessageId String?
  /// 通知本文に載せるための最新メッセージ抜粋
  lastInboundText      String?
  /// 担当者からの最新返信
  lastOutboundAt       DateTime?

  /// 【仕様①】リマインド経過時間のカウント起点。顧客の追加メッセージでリセットされる
  awaitingSince    DateTime?
  /// 【保険】直近の返信以降で最初に届いた未返信メッセージの時刻。追加メッセージではリセットしない。
  /// エスカレーション判定と「連投による通知先延ばし」防止に使う
  firstUnrepliedAt DateTime?

  reminderCount   Int       @default(0)
  lastReminderAt  DateTime?
  /// 次にリマインドを送るべき時刻。NULL = 送らない（返信済み / 通知OFF）
  nextReminderAt  DateTime?
  /// 既に発火したエスカレーション段階（EscalationRule.thresholdMinutes の最大値）
  escalationLevel Int       @default(0)

  resolvedAt   DateTime?
  resolvedVia  ResolvedVia?
  resolvedById String?

  /// 楽観ロック。管理画面の同時編集による上書き事故を防ぐ
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders Reminder[]

  /// Cron が期限到来分を引くための主索引
  @@index([nextReminderAt])
  @@index([replyState, nextReminderAt])
  @@index([handlingStatus])
  @@index([awaitingSince])
  @@map("conversations")
}

/// 送受信メッセージの全ログ
model Message {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId String?

  direction     Direction
  /// LINE 側のメッセージID。Webhook 再送の冪等性担保に使う
  lineMessageId String?   @unique
  messageType   String    @default("text")
  text          String?
  sentAt        DateTime
  /// 送信した担当者（OUTBOUND のみ）
  sentByStaffId String?
  sentByStaff   Staff?    @relation(fields: [sentByStaffId], references: [id], onDelete: SetNull)
  /// LINE_WEBHOOK / ADMIN_CONSOLE / INGEST_API / MANUAL
  source        String
  raw           Json?
  createdAt     DateTime  @default(now())

  @@index([customerId, sentAt])
  @@index([conversationId, sentAt])
  @@index([direction, sentAt])
  @@map("messages")
}

/// 送信した（または送信しようとした）リマインドの記録。二重通知防止の要。
model Reminder {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  kind     ReminderKind
  /// この未返信サイクル内での通知回数（1始まり）
  sequence Int

  /// 【二重通知防止】同一サイクル・同一段階の通知を物理的に1件に制限する冪等キー
  dedupeKey String @unique

  scheduledFor     DateTime
  /// 通知時点の未返信経過（分）
  unrepliedMinutes Int
  status           ReminderStatus @default(PENDING)
  attempts         Int            @default(0)
  /// 解決済みの通知先（チャネル種別・宛先・担当者名）
  targets          Json
  /// 実際に送った本文（監査用）
  bodyText         String
  sentAt           DateTime?
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([conversationId, createdAt])
  @@index([status, scheduledFor])
  @@index([createdAt])
  @@map("reminders")
}

// ---------------------------------------------------------------------------
// 設定
// ---------------------------------------------------------------------------

/// シングルトン設定（id = 1 固定）
model AppSettings {
  id       Int    @id @default(1)
  timezone String @default("Asia/Tokyo")

  /// 既定のリマインド間隔（分）。60 / 120 / 180 / 0=通知しない
  defaultReminderIntervalMinutes Int @default(60)
  /// 初回リマインドまでの待ち時間（分）
  firstReminderDelayMinutes      Int @default(60)
  /// 1サイクルあたりの最大通知回数（0 = 無制限）
  maxRemindersPerCycle           Int @default(0)

  /// 営業時間。{"mon":{"enabled":true,"open":"09:00","close":"20:00"}, ...}
  businessHours          Json
  /// 営業時間を尊重する（false なら24時間通知）
  respectBusinessHours   Boolean @default(true)
  /// 祝日も営業する
  openOnPublicHolidays   Boolean @default(false)
  /// 経過時間を営業時間のみでカウントする（false = 実時間）
  countBusinessHoursOnly Boolean @default(false)

  /// 【保険】firstUnrepliedAt からこの分数を超えたら、起点リセットに関係なく強制通知
  maxSilenceGuardMinutes Int @default(180)
  /// 配信予定を過ぎてこの分数以上滞留したら異常とみなし要確認＋管理者通知
  watchdogDelayMinutes   Int @default(20)

  /// 担当者が設定されていても、社内共通の通知先へ必ず同報する。
  /// 担当者以外（事務など）が返信することがあるため、既定で有効。
  alwaysNotifyDefaultGroup Boolean @default(true)

  /// 2回目以降のリマインドを1通にまとめて送る。
  /// 問い合わせが多いと1件1通では社内LINEが埋まり、かえって見落とすため。
  /// 初回とエスカレーションは、ボタン付きの個別通知のまま。
  digestRepeatReminders Boolean @default(true)

  /// リマインド本文のテンプレート。空なら既定の文面を使う。
  /// {顧客名} {担当者} {経過時間} などを差し込める。
  notificationTemplate String?

  /// 通知本文に顧客メッセージを含めるか
  includeMessageBodyInNotification Boolean @default(true)
  /// 通知本文に載せるメッセージの最大文字数
  messageExcerptLength             Int     @default(60)

  /// メッセージ保持期間（月）。0 = 無期限
  dataRetentionMonths Int @default(24)

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// 祝日・臨時休業日 / 臨時営業日
model BusinessHoliday {
  id     String   @id @default(cuid())
  /// 対象日（タイムゾーンは AppSettings.timezone 基準の暦日）
  date   DateTime @unique @db.Date
  name   String
  /// true にすると「祝日だがこの日は営業する」臨時営業日として扱う
  isOpen Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([date])
  @@map("business_holidays")
}

/// エスカレーション設定
model EscalationRule {
  id               String   @id @default(cuid())
  name             String
  /// 未返信がこの分数を超えたら発火（firstUnrepliedAt 基準）
  thresholdMinutes Int      @unique
  notifyAssignee   Boolean  @default(true)
  notifyManager    Boolean  @default(false)
  notifyAdmins     Boolean  @default(false)
  notifyGroup      Boolean  @default(false)
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled, thresholdMinutes])
  @@map("escalation_rules")
}

/// 社内通知チャネル
model NotificationChannel {
  id        String         @id @default(cuid())
  name      String
  type      ChannelType
  /// LINE の groupId / userId、または Webhook URL
  target    String
  purpose   ChannelPurpose @default(DEFAULT_GROUP)
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([purpose, enabled])
  @@map("notification_channels")
}

// ---------------------------------------------------------------------------
// 冪等性・監査
// ---------------------------------------------------------------------------

/// LINE Webhook の冪等性担保。再送された同一イベントを無視するために使う
model WebhookEvent {
  id             String    @id @default(cuid())
  webhookEventId String    @unique
  eventType      String
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  isRedelivery   Boolean   @default(false)
  raw            Json

  @@index([receivedAt])
  @@map("webhook_events")
}

/// 操作監査ログ
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Cron の死活記録（外部監視から参照する）
/// Webhook 受け口に届いたリクエストの受信記録。
///
/// 「入口が詰まっていることに気づけない」のが、このシステムで一番怖い壊れ方。
/// Lステップの転送が止まっても、設定を間違えても、外形上はただ静かになるだけで
/// 未返信の検知が丸ごと止まる。ホスティング事業者のログを掘らないと分からない、
/// という状態にはしない。管理画面から直接見えるところに残す。
///
/// 本文は保存しない。届いたかどうかと、なぜ弾いたか（または何件取り出せたか）だけを持つ。
model RelayReceipt {
  id         String   @id @default(cuid())
  receivedAt DateTime @default(now())
  /// 受け口の種類。'RELAY'（Lステップ転送） / 'WEBHOOK'（LINEから直接）
  endpoint   String
  /// 受理できたか
  accepted   Boolean
  /// 受理の経路（LINE_SIGNATURE / RELAY_TOKEN）または拒否理由（BAD_TOKEN 等）
  detail     String
  /// 取り出せたイベント数。受理できなかった場合は 0
  eventCount Int      @default(0)
  /// 届いたJSONの「形」だけ（値は含まない）。転送形式が想定外だったときの手がかり
  shape      String?

  @@index([receivedAt])
  @@map("relay_receipts")
}

model CronRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  claimed    Int       @default(0)
  sent       Int       @default(0)
  skipped    Int       @default(0)
  failed     Int       @default(0)
  error      String?

  @@index([job, startedAt])
  @@map("cron_runs")
}

// ---------------------------------------------------------------------------
// 物件情報の一斉配信（メール / 将来的にSMS）
//
// 公式LINEの一斉配信で反応が取れなかった層を、別チャネルで追いかけるための仕組み。
// 設計の中心は「送ってはいけない相手に絶対に送らない」こと。
//   1. Suppression（配信停止・バウンス）は Contact とは別テーブルに置き、
//      再インポートしても復活しない
//   2. CampaignRecipient に (campaignId, contactId) の UNIQUE を張り、二重送信を防ぐ
//   3. 送信直前にも Suppression を引き直す
// ---------------------------------------------------------------------------

/// 配信先の取得経路。特定電子メール法の「同意の記録」として保存する
enum ContactSource {
  LINE_FORM /// 公式LINEに流入 → フォーム回答
  WEB_FORM /// 自社サイトのフォーム
  INQUIRY /// 問い合わせ・来店・電話
  IMPORT /// CSV取込（経路が特定できないもの）
  MANUAL /// 管理画面で手入力
}

enum ConsentStatus {
  OPTED_IN /// 配信同意あり（フォームで明示的に同意を得た）
  UNKNOWN /// 自社が取得した連絡先だが、明示同意の記録が無い
  UNSUBSCRIBED /// 配信停止済み。二度と送らない
}

enum PropertyType {
  MANSION /// マンション
  HOUSE /// 戸建
  LAND /// 土地
  INVESTMENT /// 投資用・収益物件
  OTHER
}

enum CampaignChannel {
  EMAIL
  SMS /// 未実装。送信アダプタを足せばこのキューに載る
}

enum CampaignStatus {
  DRAFT /// 作成中。対象未確定
  QUEUED /// 対象を確定し、送信待ち
  SENDING /// 送信中
  PAUSED /// 一時停止（管理画面から）
  SENT /// 全件処理済み
  FAILED /// 続行不能なエラーで停止
}

enum RecipientStatus {
  PENDING /// 送信待ち
  SENT /// 送信成功
  FAILED /// 規定回数リトライしても失敗
  SKIPPED /// 送信直前の再判定で対象外になった（配信停止・バウンス等）
}

enum SuppressionReason {
  UNSUBSCRIBED /// 本人が配信停止した
  BOUNCED /// 宛先不明（ハードバウンス）
  COMPLAINED /// 迷惑メール報告
  MANUAL /// 管理者が手動で登録
}

/// 配信先。LINEの Customer とは別軸で持つ（LINEに居ない連絡先も扱うため）
model Contact {
  id    String  @id @default(cuid())
  /// 小文字に正規化して保存する。重複取込の判定キー
  email String  @unique
  name  String?
  kana  String?
  /// E.164 ではなく入力そのまま（SMS送信時に正規化する）
  phone String?

  source      ContactSource @default(IMPORT)
  consent     ConsentStatus @default(UNKNOWN)
  /// 同意を得た日時（フォーム送信日時）
  consentAt   DateTime?
  /// 「SNS広告→公式LINE→フォーム回答」など、取得経路の説明を残す
  consentNote String?

  /// 公式LINEの顧客と紐づける。LINEの反応履歴でセグメントするために使う
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// --- 希望条件（セグメント抽出に使う） ---
  areas         String[]       @default([])
  /// 予算（万円）
  budgetMin     Int?
  budgetMax     Int?
  propertyTypes PropertyType[] @default([])

  /// --- 状態 ---
  unsubscribedAt DateTime?
  bounceCount    Int       @default(0)
  lastBouncedAt  DateTime?
  lastSentAt     DateTime?
  active         Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients CampaignRecipient[]

  @@index([consent, active])
  @@index([createdAt])
  @@map("contacts")
}

/// 送ってはいけない宛先の台帳。Contact を消しても・作り直しても残る
model Suppression {
  id        String            @id @default(cuid())
  /// 小文字正規化したメールアドレス、または正規化した電話番号
  address   String            @unique
  channel   CampaignChannel   @default(EMAIL)
  reason    SuppressionReason
  note      String?
  createdAt DateTime          @default(now())

  @@index([channel, createdAt])
  @@map("suppressions")
}

/// 配信する物件
model Property {
  id            String       @id @default(cuid())
  title         String
  propertyType  PropertyType @default(OTHER)
  /// 市区町村など。Contact.areas との突き合わせに使う
  area          String?
  address       String?
  /// 価格（万円）
  price         Int?
  layout        String?
  /// 専有面積・土地面積（㎡）
  sizeSqm       Float?
  stationAccess String?
  description   String?
  /// 物件詳細ページのURL
  url           String?
  imageUrl      String?
  published     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns CampaignProperty[]

  @@index([published, createdAt])
  @@map("properties")
}

/// 一斉配信のひとまとまり
model Campaign {
  id      String          @id @default(cuid())
  name    String
  channel CampaignChannel @default(EMAIL)
  subject String
  /// 差し込み変数を含む本文。{{name}} {{properties}} {{unsubscribe_url}}
  body    String
  status  CampaignStatus  @default(DRAFT)

  /// --- セグメント条件（対象確定時に評価する） ---
  segAreas          String[]       @default([])
  segBudgetMin      Int?
  segBudgetMax      Int?
  segTypes          PropertyType[] @default([])
  /// 明示的な同意（OPTED_IN）がある人にだけ送る
  segOptedInOnly    Boolean        @default(true)
  /// 公式LINEで反応が無い人だけに送る（ブロック済み、または下記日数こちらへの発信が無い）
  segLineSilentOnly Boolean        @default(false)
  segLineSilentDays Int            @default(30)

  /// --- 進捗（対象確定時に totalCount を確定し、以降カウントアップする） ---
  totalCount   Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)

  queuedAt   DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties CampaignProperty[]
  recipients CampaignRecipient[]

  @@index([status, queuedAt])
  @@map("campaigns")
}

model CampaignProperty {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@id([campaignId, propertyId])
  @@index([campaignId, position])
  @@map("campaign_properties")
}

/// 送信キューの1件。ここに入った時点で宛先が確定する
model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// 送信時点の値を固定して保存する（後から Contact を編集しても送信記録は変わらない）
  address String
  name    String?

  status            RecipientStatus @default(PENDING)
  attempts          Int             @default(0)
  /// 次に送信を試みてよい時刻。リトライのバックオフに使う
  nextAttemptAt     DateTime        @default(now())
  /// 確保（claim）の有効期限。プロセスが落ちてもこの時刻を過ぎれば別実行が拾い直す
  claimedUntil      DateTime?
  sentAt            DateTime?
  lastError         String?
  /// 送信プロバイダ側のID。バウンス通知と突き合わせる
  providerMessageId String?

  createdAt DateTime @default(now())

  /// 同じ配信で同じ相手に二度送らないことを DB 制約で保証する
  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@map("campaign_recipients")
}
