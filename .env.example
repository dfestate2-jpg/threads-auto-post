# =============================================================================
#  公式LINE 未返信リマインドシステム — 環境変数サンプル
#  このファイルをコピーして .env を作成してください（.env はコミットしないこと）
# =============================================================================

# --- データベース（PostgreSQL） ---------------------------------------------
# アプリ実行時の接続。TLS 必須。
# Supabase の場合は「Transaction pooler」(ポート6543) を使い、末尾に
#   ?pgbouncer=true&connection_limit=1&sslmode=require
# を付けてください（サーバーレスでは接続数を使い切らないことが重要）。
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# マイグレーション実行時の接続。
# Supabase の場合は「Session pooler」(ポート5432)。
# Transaction pooler では prisma migrate が失敗します。
# プーラーを使わない環境では DATABASE_URL と同じ値で構いません。
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# --- LINE チャネル①：顧客対応用（公式アカウントに紐づくMessaging APIチャネル） ---
# LINE Developers > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=""
# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=""
# アクセストークンを取り出せない場合の代替。
# チャネルID と 上の LINE_CHANNEL_SECRET があれば、顧客名の取得に必要なトークンを
# その都度発行できます（15分で失効する使い捨て。既存のトークンには影響しません）。
# チャネルIDは 公式アカウントマネージャー > 設定 > Messaging API でも確認できます。
LINE_CHANNEL_ID=""

# --- 社内通知の既定チャネル：Slack ------------------------------------------
# 担当者未設定の顧客のリマインド送信先。
# Slack App > Incoming Webhooks で発行した URL を設定します。
# LINE と違いメッセージ通数の課金が無いため、既定はこちらを推奨。
INTERNAL_SLACK_WEBHOOK_URL=""

# --- 社内通知をLINEグループで行う場合（任意） --------------------------------
# LINE チャネル②（社内通知Bot用）。未設定ならチャネル①のトークンを流用します
LINE_NOTIFY_CHANNEL_ACCESS_TOKEN=""
# チャネル②のチャネルシークレット。
# 「対応済みにする」ボタンのタップ（postback）はチャネル②の Webhook に届くため、
# 別チャネル運用の場合はこれを設定してください（チャネル①を流用する場合は不要）。
LINE_NOTIFY_CHANNEL_SECRET=""
# 担当者未設定時に通知する社内共通LINEグループのID（Botをグループに招待して取得）
# 注意: グループ宛 push は「グループ内の人数分」として課金対象通数にカウントされます
INTERNAL_LINE_GROUP_ID=""

# --- 社内LINE通知の「対応済みにする」ボタンの署名鍵（任意） -------------------
# 未設定なら SESSION_SECRET を流用します。変更すると発行済みボタンは無効になります
QUICK_ACTION_SECRET=""

# --- Lステップ共存：Webhook転送の受け口 --------------------------------------
# Lステップの「アカウント設定 → 外部連携設定」に登録する転送先URLは
#   https://<host>/api/line/relay?token=<この値>
# openssl rand -hex 32 などで生成すること。URL自体が認証情報になります。
# 転送時に x-line-signature が引き継がれることを確認できたら、この値は外して構いません
LSTEP_RELAY_TOKEN=""
# 導入直後の疎通確認用。1 にすると転送データの「構造だけ」をログに出します（値は出しません）
LSTEP_RELAY_DEBUG=""

# --- 冗長通知（任意）：主要な通知経路が全滅したときの最終手段 -----------------
# Slack を主経路にしている場合は、別のチャネル（Discord 等）を指定すると冗長化になります
FALLBACK_WEBHOOK_URL=""

# --- Cron 実行エンドポイントの共有シークレット -------------------------------
# openssl rand -hex 32 などで生成
CRON_SECRET=""

# --- 管理画面セッションCookieの署名鍵 ----------------------------------------
# openssl rand -hex 32 などで生成
SESSION_SECRET=""

# --- 外部連携からの返信取り込みAPI用シークレット（任意） ----------------------
INGEST_SECRET=""

# --- アプリのベースURL（通知に載せる管理画面リンクの生成に使用） --------------
APP_BASE_URL="http://localhost:3000"

# --- 初期管理者（seed 実行時のみ使用） ---------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# =============================================================================
#  物件情報の一斉メール配信
# =============================================================================

# --- 送信プロバイダ ----------------------------------------------------------
# resend / sendgrid のいずれか。未設定の場合は「実送信しない動作確認モード」になり、
# 配信フローは最後まで動くがメールは飛びません（本番の鍵を入れる前の確認に使えます）。
# 自前のSMTPは使わないでください。3,000件規模を自社サーバーから送ると
# IPレピュテーションが落ち、通常の業務メールまで届かなくなります。
MAIL_PROVIDER=""
MAIL_API_KEY=""

# --- 差出人 ------------------------------------------------------------------
# 必ず「SPF・DKIM・DMARC を設定済みの自社ドメイン」のアドレスにしてください。
# 未設定のドメインから一斉送信すると Gmail / Yahoo にほぼ確実に弾かれます。
MAIL_FROM_ADDRESS="info@example.co.jp"
MAIL_FROM_NAME="〇〇不動産"
# 返信先を分けたい場合のみ設定
MAIL_REPLY_TO=""

# --- 送信者情報（特定電子メール法で本文への表示が義務） ------------------------
# これらが未設定だと配信を開始できないようにしています。
MAIL_SENDER_ORG="株式会社〇〇不動産"
MAIL_SENDER_ADDRESS="東京都〇〇区〇〇1-2-3 〇〇ビル4F"
MAIL_SENDER_TEL="03-1234-5678"

# --- 配信停止リンクの署名鍵 ---------------------------------------------------
# openssl rand -hex 32 などで生成。未設定なら SESSION_SECRET を流用します。
# 変更すると、過去に送ったメールの配信停止リンクがすべて無効になります。
UNSUBSCRIBE_SECRET=""

# --- 送信ペース --------------------------------------------------------------
# Cron 1回（1分ごと）あたりの送信件数。既定100 = 1時間あたり約6,000通。
# プロバイダのレート上限に合わせて調整してください。
MAIL_BATCH_SIZE="100"
# 同時送信数。上げすぎるとプロバイダに 429 で弾かれます。
MAIL_CONCURRENCY="4"

# --- バウンス・苦情の受け口 ---------------------------------------------------
# openssl rand -hex 32 などで生成し、プロバイダの Webhook URL に
#   https://<host>/api/email/webhook?token=<この値>
# を登録します。未設定だとバウンス通知を受け取れず、
# 宛先不明のアドレスに送り続けて到達率が落ちます。
MAIL_WEBHOOK_SECRET=""
