# =============================================================================
#  公式LINE 未返信リマインドシステム — 環境変数サンプル
#  このファイルをコピーして .env を作成してください（.env はコミットしないこと）
# =============================================================================

# --- データベース（PostgreSQL） ---------------------------------------------
# Supabase / Neon の接続文字列。TLS 必須。
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- LINE チャネル①：顧客対応用（公式アカウントに紐づくMessaging APIチャネル） ---
# LINE Developers > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=""
# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=""

# --- 社内通知の既定チャネル：Slack ------------------------------------------
# 担当者未設定の顧客のリマインド送信先。
# Slack App > Incoming Webhooks で発行した URL を設定します。
# LINE と違いメッセージ通数の課金が無いため、既定はこちらを推奨。
INTERNAL_SLACK_WEBHOOK_URL=""

# --- 社内通知をLINEグループで行う場合（任意） --------------------------------
# LINE チャネル②（社内通知Bot用）。未設定ならチャネル①のトークンを流用します
LINE_NOTIFY_CHANNEL_ACCESS_TOKEN=""
# チャネル②のチャネルシークレット。
# 「対応済みにする」ボタンのタップ（postback）はチャネル②の Webhook に届くため、
# 別チャネル運用の場合はこれを設定してください（チャネル①を流用する場合は不要）。
LINE_NOTIFY_CHANNEL_SECRET=""
# 担当者未設定時に通知する社内共通LINEグループのID（Botをグループに招待して取得）
# 注意: グループ宛 push は「グループ内の人数分」として課金対象通数にカウントされます
INTERNAL_LINE_GROUP_ID=""

# --- 社内LINE通知の「対応済みにする」ボタンの署名鍵（任意） -------------------
# 未設定なら SESSION_SECRET を流用します。変更すると発行済みボタンは無効になります
QUICK_ACTION_SECRET=""

# --- Lステップ共存：Webhook転送の受け口 --------------------------------------
# Lステップの「アカウント設定 → 外部連携設定」に登録する転送先URLは
#   https://<host>/api/line/relay?token=<この値>
# openssl rand -hex 32 などで生成すること。URL自体が認証情報になります。
# 転送時に x-line-signature が引き継がれることを確認できたら、この値は外して構いません
LSTEP_RELAY_TOKEN=""
# 導入直後の疎通確認用。1 にすると転送データの「構造だけ」をログに出します（値は出しません）
LSTEP_RELAY_DEBUG=""

# --- 冗長通知（任意）：主要な通知経路が全滅したときの最終手段 -----------------
# Slack を主経路にしている場合は、別のチャネル（Discord 等）を指定すると冗長化になります
FALLBACK_WEBHOOK_URL=""

# --- Cron 実行エンドポイントの共有シークレット -------------------------------
# openssl rand -hex 32 などで生成
CRON_SECRET=""

# --- 管理画面セッションCookieの署名鍵 ----------------------------------------
# openssl rand -hex 32 などで生成
SESSION_SECRET=""

# --- 外部連携からの返信取り込みAPI用シークレット（任意） ----------------------
INGEST_SECRET=""

# --- アプリのベースURL（通知に載せる管理画面リンクの生成に使用） --------------
APP_BASE_URL="http://localhost:3000"

# --- 初期管理者（seed 実行時のみ使用） ---------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# =============================================================================
#  銀行入金 → Googleスプレッドシート 自動反映
#  詳細は docs/10-bank-deposit-sync.md
#  ※ 銀行のログインIDやパスワードは絶対にここへ書かないこと。本システムは使いません。
# =============================================================================

# --- freee 会計 API（入金明細の取得元） --------------------------------------
# freee アプリストア > 開発者向け > アプリ管理 で自社アプリを作成して発行する。
# コールバックURLには urn:ietf:wg:oauth:2.0:oob を登録する。
FREEE_CLIENT_ID=""
FREEE_CLIENT_SECRET=""
# 初回だけ設定する値。`npm run freee:auth` で取得できる。
# 以降はDB（integration_credentials）が自動更新するため、ここを書き換える必要はない。
# （再認可したときだけ新しい値に差し替える）
FREEE_REFRESH_TOKEN=""
# 対象の事業所ID。`npm run freee:auth` の出力に表示される
FREEE_COMPANY_ID=""
# 対象の銀行口座ID（カンマ区切り）。未設定なら事業所の全銀行口座が対象になる
FREEE_WALLETABLE_IDS=""

# --- Google スプレッドシート（反映先） ---------------------------------------
# Google Cloud のサービスアカウントを作り、対象スプレッドシートを
# そのメールアドレスに「編集者」で共有する。
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# サービスアカウントJSONの private_key。改行は \n のままでよい（前後の " は必須）
GOOGLE_PRIVATE_KEY=""
# スプレッドシートURL /d/ と /edit の間の文字列
DEPOSIT_SPREADSHEET_ID=""
# 月次シートを新規作成するときの複製元シート名
DEPOSIT_TEMPLATE_SHEET_TITLE="コピー"
# 月次シート（yyyyMM）ではなく固定シートに書きたい場合のみ指定
DEPOSIT_SHEET_TITLE=""

# --- 取り込みルール ----------------------------------------------------------
# 【重要】この日付より前の入金は取り込まない（yyyy-MM-dd）。
# 手入力済みの行と重複させないため、「手入力した最終日の翌日」を入れること。
DEPOSIT_SYNC_START_DATE="2026-08-23"
# 毎回さかのぼって確認する日数（銀行側の反映遅れ・訂正を拾うための余白）
DEPOSIT_LOOKBACK_DAYS="14"
# これ未満の入金は記録しない（利息の数円などを弾く）
DEPOSIT_MIN_AMOUNT="1"
DEPOSIT_TIMEZONE="Asia/Tokyo"
# 法人格の略号の扱い: strip（既定 "カ)タマホーム"→"タマホーム"）/ expand / keep
DEPOSIT_CORPORATE_MODE="strip"
# 同じ入金日が続くとき、2行目以降のA列を空欄にする（既存の手入力に合わせる）。0で毎行に日付
DEPOSIT_OMIT_REPEATED_DATE="1"
# 1回の実行で追記する最大行数（想定外の大量書き込みを防ぐ安全弁）
DEPOSIT_MAX_ROWS_PER_RUN="200"
# 0 にすると同期を止める（障害時の緊急停止用）
DEPOSIT_SYNC_ENABLED="1"
