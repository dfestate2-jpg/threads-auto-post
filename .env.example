# ---------------------------------------------------------------------------
# データモード
#   demo … Mock Provider を使い、画面には DEMO DATA と表示する (既定)
#   live … 実データ Provider を使う。未接続の Provider は DATA UNAVAILABLE になる
# ---------------------------------------------------------------------------
DATA_MODE=demo

# --- Retail Sentiment Provider (いずれも接続実装待ち) ----------------------
# OANDA: Position Book 取得用。口座付きの API トークンが必要
OANDA_API_TOKEN=
OANDA_API_BASE=https://api-fxtrade.oanda.com

# IG: Client Sentiment 取得用
IG_API_KEY=

# FXCM: SSI 取得用
FXCM_API_TOKEN=

# --- Price Provider (接続実装待ち) ----------------------------------------
PRICE_API_TOKEN=

# --- DB (履歴保存を有効にする段階で使用) ----------------------------------
DATABASE_URL=
