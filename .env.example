# =============================================================================
#  公式LINE 未返信リマインドシステム — 環境変数サンプル
#  このファイルをコピーして .env を作成してください（.env はコミットしないこと）
# =============================================================================

# --- データベース（PostgreSQL） ---------------------------------------------
# Supabase / Neon の接続文字列。TLS 必須。
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- LINE チャネル①：顧客対応用（公式アカウントに紐づくMessaging APIチャネル） ---
# LINE Developers > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=""
# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=""

# --- 社内通知の既定チャネル：Slack ------------------------------------------
# 担当者未設定の顧客のリマインド送信先。
# Slack App > Incoming Webhooks で発行した URL を設定します。
# LINE と違いメッセージ通数の課金が無いため、既定はこちらを推奨。
INTERNAL_SLACK_WEBHOOK_URL=""

# --- 社内通知をLINEグループで行う場合（任意） --------------------------------
# LINE チャネル②（社内通知Bot用）。未設定ならチャネル①のトークンを流用します
LINE_NOTIFY_CHANNEL_ACCESS_TOKEN=""
# チャネル②のチャネルシークレット。
# 「対応済みにする」ボタンのタップ（postback）はチャネル②の Webhook に届くため、
# 別チャネル運用の場合はこれを設定してください（チャネル①を流用する場合は不要）。
LINE_NOTIFY_CHANNEL_SECRET=""
# 担当者未設定時に通知する社内共通LINEグループのID（Botをグループに招待して取得）
# 注意: グループ宛 push は「グループ内の人数分」として課金対象通数にカウントされます
INTERNAL_LINE_GROUP_ID=""

# --- 社内LINE通知の「対応済みにする」ボタンの署名鍵（任意） -------------------
# 未設定なら SESSION_SECRET を流用します。変更すると発行済みボタンは無効になります
QUICK_ACTION_SECRET=""

# --- Lステップ共存：Webhook転送の受け口 --------------------------------------
# Lステップの「アカウント設定 → 外部連携設定」に登録する転送先URLは
#   https://<host>/api/line/relay?token=<この値>
# openssl rand -hex 32 などで生成すること。URL自体が認証情報になります。
# 転送時に x-line-signature が引き継がれることを確認できたら、この値は外して構いません
LSTEP_RELAY_TOKEN=""
# 導入直後の疎通確認用。1 にすると転送データの「構造だけ」をログに出します（値は出しません）
LSTEP_RELAY_DEBUG=""

# --- 冗長通知（任意）：主要な通知経路が全滅したときの最終手段 -----------------
# Slack を主経路にしている場合は、別のチャネル（Discord 等）を指定すると冗長化になります
FALLBACK_WEBHOOK_URL=""

# --- Cron 実行エンドポイントの共有シークレット -------------------------------
# openssl rand -hex 32 などで生成
CRON_SECRET=""

# --- 管理画面セッションCookieの署名鍵 ----------------------------------------
# openssl rand -hex 32 などで生成
SESSION_SECRET=""

# --- 外部連携からの返信取り込みAPI用シークレット（任意） ----------------------
INGEST_SECRET=""

# --- アプリのベースURL（通知に載せる管理画面リンクの生成に使用） --------------
APP_BASE_URL="http://localhost:3000"

# --- 初期管理者（seed 実行時のみ使用） ---------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
