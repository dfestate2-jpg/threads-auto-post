# ---------------------------------------------------------------------------
# データモード
#   demo … Mock Provider を使い、画面には DEMO DATA と表示する (既定)
#   live … 実データ Provider を使う。未接続の Provider は DATA UNAVAILABLE になる
# ---------------------------------------------------------------------------
DATA_MODE=demo

# --- Retail Sentiment Provider --------------------------------------------
# OANDA: Position Book (約 20 分ごとのスナップショット) 取得用。
# 実口座の API トークンが必要。デモ口座は https://api-fxpractice.oanda.com
OANDA_API_TOKEN=
OANDA_API_BASE=https://api-fxtrade.oanda.com

# IG: Client Sentiment 取得用
IG_API_KEY=

# FXCM: SSI 取得用
FXCM_API_TOKEN=

# --- Large Trader Provider ------------------------------------------------
# CFTC Public Reporting は認証なしで取得できる。App Token を付けるとレート制限が緩む
CFTC_API_BASE=https://publicreporting.cftc.gov
CFTC_APP_TOKEN=

# --- Price Provider (接続実装待ち) ----------------------------------------
PRICE_API_TOKEN=

# --- DB (Retail 履歴の永続化に使用) ---------------------------------------
# 未設定ならプロセス内メモリに貯める (再起動で消える)
# 設定する場合は先に: npm run db:schema
DATABASE_URL=
